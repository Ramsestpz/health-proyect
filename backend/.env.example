# Copia este archivo como .env y llena tus valores reales (el .env NUNCA se sube a GitHub)

# Puerto de la API (Render lo asigna solo en producción)
PORT=4000

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/saludcerca?retryWrites=true&w=majority

# Clave para firmar los tokens JWT (una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# URL(s) del frontend permitidas por CORS, separadas por coma
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# (Opcional) usuario de prueba que crea "npm run seed"
SEED_USER_EMAIL=demo@saludcerca.mx
SEED_USER_PASSWORD=Demo12345
